PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) -DARMA_64BIT_WORD=1

# configure substitutes the placeholder below with -latomic where it found the
# library linkable, and with nothing otherwise. Keep it last on the line:
# --as-needed keeps a library only if it appears after the objects that
# reference it, so moving it earlier would silently drop it and bring back the
# undefined __atomic_compare_exchange.
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) @TIDYLDA_ATOMIC_LIBS@
